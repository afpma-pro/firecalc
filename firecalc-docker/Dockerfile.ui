# =============================================================================
# FireCalc UI — Docker Image
# =============================================================================
# Multi-stage build:
#   Stage 1 (builder): Node.js environment to build the Vite frontend bundle.
#   Stage 2 (runtime): Nginx serving the pre-built static assets.
#
# The UI static assets are expected in the build context `artifacts/` directory,
# produced by the deploy script from the pinned public source ref in VERSIONS.
# The deploy script copies the contents of web/dist-app/ into artifacts/ui-dist/.
# =============================================================================

# =============================================================================
# Stage 1: Builder — Build the Vite frontend bundle
# =============================================================================
FROM node:22-alpine AS builder

WORKDIR /build

# Copy the pre-built UI distribution from artifacts/
# (The deploy script runs `sbt ui/fullLinkJS` + Vite build, then copies
#  web/dist-app/ contents into artifacts/ui-dist/)
COPY artifacts/ui-dist/ /build/

# =============================================================================
# Stage 2: Runtime — Nginx serving static assets
# =============================================================================
FROM nginx:1.27-alpine AS runtime

# Remove default nginx config and content
RUN rm -rf /etc/nginx/conf.d/default.conf /usr/share/nginx/html/*

# Install curl for HEALTHCHECK
RUN apk add --no-cache curl

# Copy the built UI assets
COPY --from=builder /build/ /usr/share/nginx/html/

# Copy nginx configuration for the UI server
COPY nginx-ui.conf /etc/nginx/conf.d/default.conf

# Expose HTTP port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:80/app/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
