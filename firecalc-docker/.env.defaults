# =============================================================================
# FireCalc Docker Environment Variables — Defaults
# =============================================================================
# Copy to .env and fill in your actual values:
#   cp firecalc-docker/.env.defaults firecalc-docker/.env
#
# The copy you make (.env) is the single deployment env carrier: there are no
# per-environment overlay files (.env.staging, .env.production). Set the values
# for your environment there; FIRECALC_ENV selects configs/<env>/ and the UI
# build mode.
#
# SECURITY WARNING: Never commit the actual .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment Mode
# -----------------------------------------------------------------------------
# Choose ONE mode by creating a symlink in firecalc-docker/:
#
#   Standalone (self-contained, nginx handles TLS + calc-server):
#     ln -s docker-compose.standalone.yml docker-compose.yml
#
#   Standalone (self-contained, nginx handles TLS, no calc-server):
#     ln -s docker-compose.standalone.no-calc.yml docker-compose.yml
#
#   Behind-proxy (external reverse proxy handles TLS + calc-server):
#     ln -s docker-compose.behind-proxy.yml docker-compose.yml
#
#   Behind-proxy (external reverse proxy handles TLS, no calc-server):
#     ln -s docker-compose.behind-proxy.no-calc.yml docker-compose.yml
#
# "no calc-server" means NO calculation seam at all — not a local fallback: the
# four non-Austrian kinds still compute in the UI and payments backend, while
# Ecolabeled and Door15aCatalog have no local engine. In no-calc mode those two
# kinds stay unavailable (no browser-side engine; payments PDFs fail with
# "Austrian firebox detected but remote calculation service is not configured").
# Use a with-calc variant, or disable the kinds (see DEPLOYMENT.md).

# -----------------------------------------------------------------------------
# Shared (REQUIRED for all modes)
# -----------------------------------------------------------------------------
# Environment name used for image tagging and container naming.
# Override per environment (e.g., firecalc-staging, firecalc-production).
FIRECALC_ENV=development

# -----------------------------------------------------------------------------
# Backend Secrets (REQUIRED for all modes)
# -----------------------------------------------------------------------------
# JWT signing secret for the payments backend. Passed to the backend container
# via the docker-compose `environment:` block; substituted into
# configs/<env>/payments/payments-config.conf via `jwt.secret = ${JWT_SECRET}`
# (unresolved substitution fails loudly at startup).
# REQUIRED — generate with: openssl rand -base64 32
JWT_SECRET=

# -----------------------------------------------------------------------------
# Standalone Mode — Domain Configuration (REQUIRED for standalone variants)
# -----------------------------------------------------------------------------
# UI domain: serves the web application (landing page + SPA).
# API domain: serves the REST API (payments + firebox calculations).
# The inner nginx config is generated at container start by nginx/entrypoint.sh:
# envsubst substitutes these values into the server_name directives of
# nginx/shared/https-servers.conf, so there is no nginx file to edit by hand.
# Behind-proxy mode: nginx does NOT use these (entrypoint.sh echoes the request
# origin for CORS); they are still REQUIRED by scripts/generate-certs.sh.
UI_DOMAIN=firecalc.example.com
API_DOMAIN=api.example.com

# -----------------------------------------------------------------------------
# Let's Encrypt (standalone mode only)
# -----------------------------------------------------------------------------
# Email address for Let's Encrypt notifications and account recovery.
LETSENCRYPT_EMAIL=admin@example.com

# Set to true for staging (Let's Encrypt staging CA, no rate limits).
# Set to false for production (real certificates).
LETSENCRYPT_STAGING=true

# -----------------------------------------------------------------------------
# Behind-Proxy Mode — Trusted Proxy CIDR (REQUIRED for behind-proxy variants)
# -----------------------------------------------------------------------------
# CIDR of the outer reverse proxy; the inner nginx uses it for per-client rate
# limiting and XFF sanitization (set_real_ip_from). Narrow it to your proxy's
# actual subnet; the compose fallback is 172.16.0.0/12.
TRUSTED_PROXY_CIDR=172.16.0.0/12

# -----------------------------------------------------------------------------
# Standalone Mode — Host Port Mapping (OPTIONAL)
# -----------------------------------------------------------------------------
# Host ports mapped to nginx container ports.
# Default: 80 -> 80, 443 -> 443
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# -----------------------------------------------------------------------------
# Company Information
# -----------------------------------------------------------------------------
# Company identity (legal name, address, IBAN, VAT, registration) is configured
# directly in configs/<env>/invoices/invoice-config.yaml — NOT via environment
# variables. Only the currency below is an env override knob: it is passed to
# the backend container via the docker-compose `environment:` block and
# referenced there via ${COMPANY_CURRENCY:-EUR}.
COMPANY_CURRENCY="EUR"

# -----------------------------------------------------------------------------
# Payment Terms Configuration
# -----------------------------------------------------------------------------
# Passed to the backend container via the docker-compose `environment:` block;
# referenced by configs/<env>/invoices/invoice-config.yaml via
# ${PAYMENT_DUE_DAYS:-30} / ${LATE_FEE_PERCENTAGE:-1.5}.
PAYMENT_DUE_DAYS=30
LATE_FEE_PERCENTAGE=1.5

# -----------------------------------------------------------------------------
# Template Styling (OPTIONAL)
# -----------------------------------------------------------------------------
# Passed to the backend container via the docker-compose `environment:` block;
# referenced by configs/<env>/invoices/invoice-config.yaml via
# ${TEMPLATE_LOGO_POSITION:-top-left} / ${TEMPLATE_PRIMARY_COLOR:-#2563eb} /
# ${TEMPLATE_FONT_FAMILY:-Liberation Sans}.
TEMPLATE_LOGO_POSITION="top-left"
TEMPLATE_PRIMARY_COLOR="#2563eb"
TEMPLATE_FONT_FAMILY="Liberation Sans"
