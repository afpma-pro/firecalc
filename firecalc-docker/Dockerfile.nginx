# =============================================================================
# FireCalc Nginx Reverse Proxy — Docker Image
# =============================================================================
# Lightweight nginx container for routing traffic between frontend and
# backend services. Configuration templates are processed at startup via
# envsubst to substitute domain placeholders.
# =============================================================================

FROM nginx:1.27-alpine
RUN apk add --no-cache curl gettext

COPY nginx/entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Create writable directory for generated nginx configuration
# (entrypoint writes processed config here at container startup)
RUN mkdir -p /etc/nginx/generated && chown nginx:nginx /etc/nginx/generated

# Master runs as root (binds port 80, writes /var/run/nginx.pid); worker
# processes drop to the nginx user via the "user nginx;" directive that the
# variant templates put in every generated config.

ENTRYPOINT ["/docker-entrypoint.sh"]
