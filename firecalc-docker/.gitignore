# Build artifacts (produced by deploy script, not committed)
artifacts/

# Runtime configs with credentials (use .template/.example counterparts instead)
configs/**
!configs/**/
!configs/**/*.template
!configs/**/*.example

# Database files (transactional data)
databases/

# Environment files
.env
.env.*
!.env.example
!.env.defaults

# Docker compose symlinks
docker-compose.yml

# Build and Let's Encrypt directories (created by deploy/init scripts)
.build/
.certbot/
.certs/
certbot-webroot/
