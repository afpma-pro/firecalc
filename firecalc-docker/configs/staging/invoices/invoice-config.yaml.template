# Quick-start scaffold — copy to invoice-config.yaml and fill in values.
# The canonical documented starting point is invoice-config.yaml.example in
# this directory: it explains every key, the environment-variable hooks, and
# exactly which six keys the compose files pass. Use the .example whenever the
# details matter; this scaffold is only the minimal fill-in-the-blanks form.
#
# Invoice Configuration - STAGING Environment
# Config = what the org is; runtime data (lineItems, recipient, invoiceNumber, etc.)
# lives elsewhere and is provided at generation time.
#
# The productCatalog block below is machine-generated from the Scala catalog
# (regenerate with: sbt --client "payments/genYamlTemplate") — never hand-edit
# it. CI checks its SKU/locale coverage against the catalog on every run with:
#   sbt --client "payments/verifyYamlAgainstCatalog"

invoice:
  sender:
    name: "YOUR_ORGANIZATION_NAME"
    displayName: "YOUR_ORGANIZATION_DISPLAY_NAME"
    address:
      street: "YOUR_STREET_ADDRESS"
      streetLine2: "YOUR_STREET_LINE_2"
      city: "YOUR_CITY"
      postalCode: "YOUR_POSTAL_CODE"
      region: "YOUR_REGION"
      country: "France"
    vatNumber: "YOUR_VAT_NUMBER"
    registrationNumber: "YOUR_REGISTRATION_NUMBER"
    email: "YOUR_CONTACT_EMAIL"
    phone: "YOUR_PHONE"
    website: "YOUR_WEBSITE"
    logo: !!null
    taxExemptNotice:
      fr: "TVA non applicable, art. 293 B du CGI"
      en: "Non-profit organization - Tax exempt"
      default: "Tax exempt"
  productCatalog:
    entries:
      pdf_report_EN_15544_2023:
        default:
          name: "Calculation Report NF EN 15544:2023"
          description: "Calculation report compliant with NF EN 15544:2023 standard"
        en:
          name: "Calculation Report NF EN 15544:2023"
          description: "Calculation report compliant with NF EN 15544:2023 standard"
        fr:
          name: "Note de calcul NF EN 15544:2023"
          description: "Note de calcul conforme à la norme NF EN 15544:2023"
      pdf_report_EN_15544_2023_WITH_FIREBOX_LICENSE_FEE:
        default:
          name: "Calculation Report EN 15544:2023 + Firebox License"
          description: "Calculation report compliant with NF EN 15544:2023 with firebox license"
        en:
          name: "Calculation Report EN 15544:2023 + Firebox License"
          description: "Calculation report compliant with NF EN 15544:2023 with firebox license"
        fr:
          name: "Note de calcul EN 15544:2023 + Licence foyer"
          description: "Note de calcul conforme à la norme NF EN 15544:2023 avec licence foyer"
  paymentTerms:
    dueDays: ${PAYMENT_DUE_DAYS:-30}
    description: "Payment due within ${PAYMENT_DUE_DAYS:-30} days of invoice date"
    lateFeePercentage: ${LATE_FEE_PERCENTAGE:-1.5}
    discountPercentage: ${EARLY_DISCOUNT_PERCENTAGE:-0.0}
    discountDays: ${EARLY_DISCOUNT_DAYS:-10}
    methods:
      -
        BankTransfer:
          iban: "YOUR_IBAN"
          bic: "YOUR_BIC"
    notes: ""
  currency: "${COMPANY_CURRENCY:-EUR}"
  notes: "YOUR_INVOICE_NOTES [STAGING]"
template:
  logoPosition: "${TEMPLATE_LOGO_POSITION:-top-left}"
  primaryColor: "${TEMPLATE_PRIMARY_COLOR:-#2563eb}"
  fontFamily: "${TEMPLATE_FONT_FAMILY:-Liberation Sans}"
