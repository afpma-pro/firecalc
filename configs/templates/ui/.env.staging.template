# Staging environment configuration for FireCalc UI
# Copy this file to modules/ui/.env.staging and customize as needed

# Backend API Configuration
# The UI makes cross-origin API calls to the API domain
# Backend must handle CORS headers for API_DOMAIN → UI_DOMAIN requests
# For staging: api.staging.firecalc.example.com (matches API_DOMAIN in docker/.env)
VITE_BACKEND_PROTOCOL=https
VITE_BACKEND_HOST=api.staging.firecalc.example.com
VITE_BACKEND_PORT=443
VITE_BACKEND_BASE_PATH=/v1

# URL to Conditions Generales de Vente (CGUV / Terms and Conditions of Sale)
VITE_CGUV_URL=https://firecalc.example.com/conditions-generales-de-vente

# Optional: Add staging-specific feature flags or settings here
# VITE_FEATURE_FLAG_EXAMPLE=true
# VITE_ANALYTICS_ENABLED=false

# Remote Firebox Calculation Configuration (ticket 21 cutover)
# Ecolabeled and Door15aCatalog compute exclusively on the standalone
# firebox-calc backend; the browser never runs the Austrian engine.
# Nginx routes exactly GET /v1/kinds and POST /v1/calculate on the API
# domain to the calc backend — the base URL is the API domain's /v1
# prefix (same origin as VITE_BACKEND_HOST) and the client appends
# /calculate and /kinds. Do not leave the base URL empty in deployed
# builds: Austrian kinds have no browser-side calculation source.
# The calc backend may be self-hosted on the same host (port 9000 behind the
# /v1 prefix); its assembly JAR is built in the private repository. Leaving
# the base URL empty does not make these kinds local — they stop working.
VITE_FIREBOX_REMOTE_KINDS=ecolabeled,door15a-catalog
VITE_FIREBOX_CALC_BASE_URL=https://api.staging.firecalc.example.com/v1
# Prefetch retry defaults (matching UIConfig.scala fallbacks)
VITE_FIREBOX_PREFETCH_MAX_RETRIES=5
VITE_FIREBOX_PREFETCH_BASE_DELAY_MS=1000
VITE_FIREBOX_PREFETCH_MAX_DELAY_MS=30000
