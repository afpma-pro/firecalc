# Development environment configuration for FireCalc UI
# Copy this file to modules/ui/.env.development and customize as needed

# Backend API Configuration
# For local development, the backend typically runs on localhost
VITE_BACKEND_PROTOCOL=http
VITE_BACKEND_HOST=localhost
VITE_BACKEND_PORT=8181
VITE_BACKEND_BASE_PATH=/v1

# URL to Conditions Generales de Vente (CGUV / Terms and Conditions of Sale)
VITE_CGUV_URL=https://firecalc.example.com/conditions-generales-de-vente

# Remote Firebox Calculation Configuration
# Ecolabeled and Door15aCatalog have NO local engine — this repository ships no
# Austrian engine source. They compute only on the calc backend (self-hostable
# on this host: firecalc-calc-server, port 9000, /v1 route prefix; the assembly
# JAR is built in the private repository).
# Leaving VITE_FIREBOX_CALC_BASE_URL empty keeps only the four non-Austrian
# kinds (traditional, afpma-prse, single-tested, custom-for-lab) in-process.
# The Austrian kinds are then non-functional: the UI has no browser-side engine
# for them (folded-only carriers, degenerate output) and the payments backend
# rejects their PDFs with "Austrian firebox detected but remote calculation
# service is not configured". Without a calc backend, disable them instead:
# VITE_FIREBOX_AVAIL_ECOLABELED=false, VITE_FIREBOX_AVAIL_DOOR15A_CATALOG=false
# and firebox-availability.ecolabeled=false / firebox-availability.door15a-catalog=false.
# Setting the base URL activates remote calculation for the kinds listed in
# VITE_FIREBOX_REMOTE_KINDS (comma-separated firebox kind identifiers); it
# carries the /v1 prefix and the client appends /calculate and /kinds.
VITE_FIREBOX_REMOTE_KINDS=
VITE_FIREBOX_CALC_BASE_URL=
# Prefetch retry defaults (matching UIConfig.scala fallbacks)
VITE_FIREBOX_PREFETCH_MAX_RETRIES=5
VITE_FIREBOX_PREFETCH_BASE_DELAY_MS=1000
VITE_FIREBOX_PREFETCH_MAX_DELAY_MS=30000
