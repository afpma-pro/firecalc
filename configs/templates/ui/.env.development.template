# Development environment configuration for FireCalc UI
# Copy this file to modules/ui/.env.development and customize as needed

# Backend API Configuration
# For local development, the backend typically runs on localhost
VITE_BACKEND_PROTOCOL=http
VITE_BACKEND_HOST=localhost
VITE_BACKEND_PORT=8181
VITE_BACKEND_BASE_PATH=/v1

# URL to Conditions Generales de Vente (CGUV / Terms and Conditions of Sale)
VITE_CGUV_URL=https://firecalc.example.com/conditions-generales-de-vente

# Remote Firebox Calculation Configuration
# Leave VITE_FIREBOX_CALC_BASE_URL empty to keep all calculations local.
# Setting it activates remote calculation for the kinds listed in VITE_FIREBOX_REMOTE_KINDS.
# VITE_FIREBOX_REMOTE_KINDS takes a comma-separated list of firebox kind identifiers.
VITE_FIREBOX_REMOTE_KINDS=
VITE_FIREBOX_CALC_BASE_URL=
# Prefetch retry defaults (matching UIConfig.scala fallbacks)
VITE_FIREBOX_PREFETCH_MAX_RETRIES=5
VITE_FIREBOX_PREFETCH_BASE_DELAY_MS=1000
VITE_FIREBOX_PREFETCH_MAX_DELAY_MS=30000
