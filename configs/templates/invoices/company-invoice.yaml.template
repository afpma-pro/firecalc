invoice: 
  invoiceNumber: "FCALC-001"
  invoiceDate: "2025-09-05"
  dueDate: "2025-10-05"
  reference: "-"
  sender: 
    name: "Association Française du Poêle Maçonné Artisanal"
    displayName: "Association Française du Poêle Maçonné Artisanal"
    address: 
      street: "Lycée des Métiers du Bâtiment"
      streetLine2: "43 route d'Aubusson"
      city: "FELLETIN"
      postalCode: "23500"
      region: "Nouvelle-Aquitaine"
      country: "France"
    vatNumber: "non applicable"
    registrationNumber: "RNA W031002573"
    email: "contact@afpma.pro"
    phone: "(+33) 5 55 83 46 29"
    website: "www.afpma.pro"
    logo: !!null
  # Product catalog: the entries below MUST cover every active SKU of the
  # Scala catalog (afpma.firecalc.payments.shared.api.v1.StagingProductCatalog).
  # This block is machine-maintained — regenerate it with:
  #   sbt --client "payments/genYamlTemplate"
  # and every CI run verifies it covers every active SKU with a "default"
  # locale entry (coverage, not byte-for-byte fidelity to the generator) by:
  #   sbt --client "payments/verifyYamlAgainstCatalog"
  productCatalog:
    entries:
      pdf_report_EN_15544_2023:
        default:
          name: "Calculation Report NF EN 15544:2023"
          description: "Calculation report compliant with NF EN 15544:2023 standard"
        en:
          name: "Calculation Report NF EN 15544:2023"
          description: "Calculation report compliant with NF EN 15544:2023 standard"
        fr:
          name: "Note de calcul NF EN 15544:2023"
          description: "Note de calcul conforme à la norme NF EN 15544:2023"
      pdf_report_EN_15544_2023_WITH_FIREBOX_LICENSE_FEE:
        default:
          name: "Calculation Report EN 15544:2023 + Firebox License"
          description: "Calculation report compliant with NF EN 15544:2023 with firebox license"
        en:
          name: "Calculation Report EN 15544:2023 + Firebox License"
          description: "Calculation report compliant with NF EN 15544:2023 with firebox license"
        fr:
          name: "Note de calcul EN 15544:2023 + Licence foyer"
          description: "Note de calcul conforme à la norme NF EN 15544:2023 avec licence foyer"
  recipient: 
    name: "ACME France"
    displayName: !!null
    address: 
      street: "${CLIENT_STREET:-123 Boulevard}"
      streetLine2: !!null
      city: "Paris"
      postalCode: "75000}"
      region: "Ile-de-France"
      country: "France"
    vatNumber: "TVA FR XXXXXXXX"
    registrationNumber: "-"
    email: "client@domaine.fr"
    phone: "+33 1 23 45 67 89"
    website: "www.domaine.fr"
    logo: !!null
  billTo: !!null
  lineItems: 
    - 
      description: "Génération rapport PDF conforme à EN 15544"
      quantity: 1
      unitPrice: 89.00
      taxRate: 20.0
      discountPercentage: !!null
      unit: "u"
      productCode: !!null
  paymentTerms: 
    dueDays: ${PAYMENT_DUE_DAYS:-30}
    description: "Payment due within ${PAYMENT_DUE_DAYS:-30} days of invoice date"
    lateFeePercentage: ${LATE_FEE_PERCENTAGE:-1.5}
    discountPercentage: ${EARLY_DISCOUNT_PERCENTAGE:-0.0}
    discountDays: ${EARLY_DISCOUNT_DAYS:-10}
    methods:
      -
        BankTransfer:
          iban: "[REDACTED]"
          bic: "[REDACTED]"
      # Uncomment to mark SEPA Direct Debit as an accepted method.
      # Mandate fields (mandateReference, mandateDate, nextPossibleChargeDate)
      # are populated at runtime from GoCardless when the mandate is created;
      # leave them as null here. The invoice renderer shows a "pending"
      # placeholder until they're filled in by the caller.
      # -
      #   SepaMandate:
      #     mandateReference: !!null
      #     mandateDate: !!null
      #     iban: "[CREDITOR_IBAN]"
      #     nextPossibleChargeDate: !!null
    notes: ""
  currency: "${COMPANY_CURRENCY:-EUR}"
  notes: "L'AFPMA vous remercie pour votre commande !"
  discountPercentage: !!null
  status: "Draft"
template: 
  logoPosition: "${TEMPLATE_LOGO_POSITION:-top-left}"
  primaryColor: "${TEMPLATE_PRIMARY_COLOR:-#2563eb}"
  fontFamily: "${TEMPLATE_FONT_FAMILY:-Liberation Sans}"
