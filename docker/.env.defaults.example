# =============================================================================
# FireCalc Docker Environment Variables - Defaults
# =============================================================================
# Copy to .env.defaults and fill in your actual values:
#   cp docker/.env.defaults.example docker/.env.defaults
#
# This file contains ALL variables with generic defaults.
# Environment-specific overrides (.env.staging, .env.production) replace
# values for their environment. Last value wins for duplicates.
#
# SECURITY WARNING: Never commit the actual .env.defaults file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment Mode
# -----------------------------------------------------------------------------
# Choose ONE mode by creating a symlink:
#   Standalone (self-contained, nginx handles TLS):
#     cd docker && ln -s docker-compose.standalone.yml docker-compose.yml
#   Behind-proxy (external reverse proxy handles TLS):
#     cd docker && ln -s docker-compose.behind-proxy.yml docker-compose.yml
#
# Or use Makefile targets:
#   make docker-setup-standalone
#   make docker-setup-behind-proxy

# -----------------------------------------------------------------------------
# Standalone Mode (REQUIRED only for docker-compose.standalone.yml)
# -----------------------------------------------------------------------------
# Override per environment (e.g. firecalc.staging.example.com)
UI_DOMAIN=firecalc.example.com
API_DOMAIN=api.example.com

# -----------------------------------------------------------------------------
# Let's Encrypt (standalone mode)
# -----------------------------------------------------------------------------
# Set to false in production overrides
LETSENCRYPT_STAGING=true

# -----------------------------------------------------------------------------
# Standalone Mode - Host Port Mapping (OPTIONAL)
# -----------------------------------------------------------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# -----------------------------------------------------------------------------
# Shared (REQUIRED for both modes)
# Override per environment (e.g. firecalc-staging, firecalc-production)
COMPOSE_PROJECT_NAME=firecalc
FIRECALC_ENV=development

# -----------------------------------------------------------------------------
# Company Information
# -----------------------------------------------------------------------------
COMPANY_LEGAL_NAME="Your Company Legal Name Inc"
COMPANY_DISPLAY_NAME="Your Company"
COMPANY_EMAIL="billing@yourcompany.com"
COMPANY_PHONE="+1 555 123 4567"
COMPANY_WEBSITE="https://www.yourcompany.com"
COMPANY_STREET="123 Your Business Street"
COMPANY_STREET_LINE2="Suite 100"
COMPANY_CITY="Your City"
COMPANY_POSTAL_CODE="12345"
COMPANY_REGION="Your Region"
COMPANY_COUNTRY="Your Country"
COMPANY_VAT_NUMBER="YOUR_VAT_NUMBER_HERE"
COMPANY_REGISTRATION="YOUR_REGISTRATION_NUMBER_HERE"
COMPANY_IBAN="YOUR_IBAN_NUMBER_HERE"
COMPANY_BIC="YOUR_BIC_CODE_HERE"
COMPANY_CURRENCY="EUR"

# -----------------------------------------------------------------------------
# Payment Terms Configuration
# -----------------------------------------------------------------------------
PAYMENT_DUE_DAYS=30
LATE_FEE_PERCENTAGE=1.5
EARLY_DISCOUNT_PERCENTAGE=2.0
EARLY_DISCOUNT_DAYS=10

# -----------------------------------------------------------------------------
# Invoice Configuration
# Override per environment (e.g. "FCALC-STG-[YYYY]-" for staging)
INVOICE_PREFIX="FCALC-[YYYY]-"
INVOICE_DIGITS=4
INVOICE_STARTING_NUMBER=1

# -----------------------------------------------------------------------------
# Email/SMTP Configuration
# -----------------------------------------------------------------------------
# SMTP credentials (USERNAME, PASSWORD) are environment-specific —
# set them in .env.staging or .env.production.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS="noreply@example.com"
EMAIL_FROM_NAME="FireCalc"
ADMIN_EMAIL="admin@example.com"

# -----------------------------------------------------------------------------
# GoCardless Payment Gateway Configuration
# -----------------------------------------------------------------------------
# Credentials (ACCESS_TOKEN, WEBHOOK_SECRET) and redirect URIs are
# environment-specific — set them in .env.staging or .env.production.
GOCARDLESS_ENVIRONMENT=sandbox
GOCARDLESS_ADMIN_EMAIL="payments@example.com"
GOCARDLESS_BASE_URL="https://api.gocardless.com"

# -----------------------------------------------------------------------------
# Template Styling (OPTIONAL)
# -----------------------------------------------------------------------------
TEMPLATE_LOGO_POSITION="top-left"
TEMPLATE_PRIMARY_COLOR="#2563eb"
TEMPLATE_FONT_FAMILY="Liberation Sans"

# -----------------------------------------------------------------------------
# Retry Configuration (OPTIONAL)
# -----------------------------------------------------------------------------
RETRY_MAX_RETRIES=5
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000

# -----------------------------------------------------------------------------
# Database Configuration (OPTIONAL)
# -----------------------------------------------------------------------------
# DB_FILENAME="firecalc-payments.db"
# DB_PATH="./databases/firecalc-payments.db"

# -----------------------------------------------------------------------------
# Product Catalog Configuration (OPTIONAL)
# Override per environment (staging, production)
PRODUCT_CATALOG=development

# -----------------------------------------------------------------------------
# Feature Flags (OPTIONAL)
# -----------------------------------------------------------------------------
INVOICE_GENERATION_ENABLED=true
EMAIL_ENABLED=true
# Set to true in staging overrides
REPORT_AS_DRAFT=false
