# =============================================================================
# FireCalc Docker Environment Variables - Staging Overrides
# =============================================================================
# Copy to .env.staging and fill in your actual values:
#   cp docker/.env.staging.example docker/.env.staging
#
# Only variables that differ from defaults.
# Merged on top of .env.defaults by setup-env.sh.
# =============================================================================

UI_DOMAIN=firecalc.staging.example.com
API_DOMAIN=api.staging.example.com
COMPOSE_PROJECT_NAME=firecalc-staging
FIRECALC_ENV=staging
INVOICE_PREFIX="FCALC-STG-[YYYY]-"
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USERNAME="your-mailtrap-username"
SMTP_PASSWORD="your-mailtrap-password"
EMAIL_FROM_ADDRESS="noreply@staging.example.com"
EMAIL_FROM_NAME="FireCalc Staging"
# GoCardless credentials (SANDBOX)
GOCARDLESS_ACCESS_TOKEN="sandbox_your_access_token_here"
GOCARDLESS_WEBHOOK_SECRET="your_webhook_secret_here"
GOCARDLESS_ENVIRONMENT=sandbox
GOCARDLESS_BASE_URL="https://api-sandbox.gocardless.com"
GOCARDLESS_REDIRECT_URI="https://${API_DOMAIN}/v1/payment_complete"
GOCARDLESS_EXIT_URI="https://${API_DOMAIN}/v1/payment_cancelled"
# JWT secret (generate with: openssl rand -base64 32)
JWT_SECRET="GENERATE_WITH_openssl_rand_-base64_32"
PRODUCT_CATALOG=staging
REPORT_AS_DRAFT=true

# Behind-proxy mode only: outer proxy's CIDR on the shared `proxy` network;
# drives set_real_ip_from so client real IP is restored for rate limiting.
# Narrow to the exact proxy subnet (e.g. 172.20.0.0/16) when known.
TRUSTED_PROXY_CIDR=172.16.0.0/12

# -----------------------------------------------------------------------------
# Remote Firebox Calculation Configuration (ticket 21 cutover)
# -----------------------------------------------------------------------------
# Ecolabeled and Door15aCatalog compute exclusively on the standalone
# firebox-calc backend (calc-backend service, port 9000). Nginx routes
# exactly GET /v1/kinds and POST /v1/calculate on the API domain to the
# calc backend; the base URL is the API domain's /v1 prefix.
# VITE_FIREBOX_REMOTE_KINDS takes a comma-separated list of firebox kind
# identifiers. Do not leave the base URL empty in deployed builds.
# The calc backend is self-hosted in the same stack (CALC_SERVER=true /
# FIRECALC_MODE=with-calc, container port 9000); its assembly JAR is built in
# the private repository. An empty base URL does not fall back to a local
# engine: only the four non-Austrian kinds compute in-process and
# Ecolabeled / Door15aCatalog become unavailable.
VITE_FIREBOX_REMOTE_KINDS=ecolabeled,door15a-catalog
VITE_FIREBOX_CALC_BASE_URL=https://api.staging.example.com/v1
# Prefetch retry defaults (matching UIConfig.scala fallbacks)
VITE_FIREBOX_PREFETCH_MAX_RETRIES=5
VITE_FIREBOX_PREFETCH_BASE_DELAY_MS=1000
VITE_FIREBOX_PREFETCH_MAX_DELAY_MS=30000
