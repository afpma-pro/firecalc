# =============================================================================
# FireCalc Calculation Backend - Docker Image
# =============================================================================
# Standalone calculation server container. No payments dependencies, no
# database mounts, no Typst — just a JRE and the calculation assembly JAR.
#
# Health endpoint: GET /health (returns JSON with status and endpoints)
# Calculation endpoints: GET /v1/kinds, POST /v1/calculate
# =============================================================================

FROM eclipse-temurin:21-jre-jammy

# Install curl for health checks
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# Create a non-root user for running the application
RUN groupadd -r -g 999 appuser && \
    useradd -r -u 999 -g appuser -d /app -s /sbin/nologin -c "Application user" appuser

# Set working directory
WORKDIR /app

# Copy the pre-built assembly JAR. Built in the private (non-AGPL) repository
# (ticket 14): the public repository no longer contains the firebox_calc_server
# module (ticket 20). The private build produces the same relative path
# (modules/firebox_calc_server/target/scala-3.8.4/firecalc-calc-server-assembly.jar),
# so the build context is the private checkout.
COPY modules/firebox_calc_server/target/scala-3.8.4/firecalc-calc-server-assembly.jar /app/firecalc-calc-server-assembly.jar

# Create mount point for configuration (read-only)
# Configuration file: firebox-calc-server.conf (HOCON, private repository)
RUN mkdir -p /app/configs && \
    chown -R appuser:appuser /app/configs && \
    chmod 700 /app/configs

# Switch to non-root user
USER appuser

# Expose calculation server port
EXPOSE 9000

# Health check against the operational health endpoint
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:9000/health || exit 1

# Application command
CMD ["java", "-jar", "/app/firecalc-calc-server-assembly.jar"]
