# =============================================================================
# FireCalc Custom Nginx Proxy Configuration
# =============================================================================
# This configuration handles TWO domains in a single nginx instance:
# - UI_DOMAIN: Proxies to ui-server for static files
# - API_DOMAIN: Proxies to backend for API requests
#
# Processed by the official nginx image's envsubst mechanism.
# Only ${UI_DOMAIN} and ${API_DOMAIN} are substituted (controlled by
# NGINX_ENVSUBST_FILTER in docker-compose.yml).
# SSL defaults, rate-limiting zones, and resolver are in nginx.conf.
# =============================================================================

# Upstream for UI static files
upstream ui_upstream {
    server ui-server:80;
}

# Upstream for API backend
upstream api_upstream {
    server backend:8181;
}
# Upstream for standalone calculation backend
upstream calc_upstream {
    server calc-backend:9000;
}

# =============================================================================
# CORS for the firebox calculation API (ticket 21)
# =============================================================================
# The browser UI (UI domain) calls GET /v1/kinds and POST /v1/calculate
# cross-origin on the API domain. The private calc backend deliberately has
# no CORS middleware, so nginx supplies the headers here. The allowed origin
# is the UI origin (envsubst inserts ${UI_DOMAIN}). Any other Origin maps to
# empty and receives no Access-Control-Allow-Origin header.
map $http_origin $firecalc_cors_origin {
    default "";
    "https://${UI_DOMAIN}" "https://${UI_DOMAIN}";
}

# =============================================================================
# Server Block: UI Domain (HTTPS)
# =============================================================================
server {
    listen 443 ssl http2;
    server_name ${UI_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${UI_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${UI_DOMAIN}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/${UI_DOMAIN}/fullchain.pem;

    # HSTS (SEC-009)
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Let's Encrypt challenge location
    location /.well-known/acme-challenge {
        default_type "text/plain";
        root /var/www/certbot;
        try_files $uri =404;
    }

    # Proxy to UI server
    # Note: CSP is defined in index.html meta tag (environment-specific via Vite build)
    location / {
        proxy_pass http://ui_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# =============================================================================
# Server Block: API Domain (HTTPS)
# =============================================================================
server {
    listen 443 ssl http2;
    server_name ${API_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${UI_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${UI_DOMAIN}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/${UI_DOMAIN}/fullchain.pem;

    # HSTS (SEC-009)
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Let's Encrypt challenge location
    location /.well-known/acme-challenge {
        default_type "text/plain";
        root /var/www/certbot;
        try_files $uri =404;
    }

    # Request body size limit (SEC-010)
    client_max_body_size 50m;

    # API-specific security headers
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none';" always;

    # Rate-limited auth endpoints (SEC-003)
    location = /v1/purchase/verify-and-process {
        limit_req zone=api_auth burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location = /v1/purchase/create-intent {
        limit_req zone=api_intent burst=3 nodelay;
        limit_req_status 429;
        proxy_pass http://api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    # Firebox calculation API (unauthenticated, CPU-bound solver)
    # CORS (ticket 21): the browser UI calls these two endpoints cross-origin
    # from the UI domain. $firecalc_cors_origin maps the request Origin to the
    # allowed UI origin (empty otherwise — no CORS headers are emitted and the
    # browser rejects the response). Preflights are answered here and never
    # forwarded to the calc backend.
    location = /v1/calculate {
        limit_req zone=firebox_calc burst=5 nodelay;
        limit_req_status 429;

        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin $firecalc_cors_origin always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, X-Firecalc-App-Key" always;
            add_header Access-Control-Max-Age 86400 always;
            add_header Content-Length 0;
            add_header Content-Type "text/plain charset=UTF-8";
            return 204;
        }

        add_header Access-Control-Allow-Origin $firecalc_cors_origin always;
        add_header Access-Control-Expose-Headers "X-RateLimit-Limit, X-RateLimit-Remaining, X-RateLimit-Reset, Retry-After" always;
        add_header Vary "Origin" always;

        proxy_pass http://calc_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location = /v1/kinds {
        limit_req zone=firebox_calc burst=10 nodelay;
        limit_req_status 429;

        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin $firecalc_cors_origin always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, X-Firecalc-App-Key" always;
            add_header Access-Control-Max-Age 86400 always;
            add_header Content-Length 0;
            add_header Content-Type "text/plain charset=UTF-8";
            return 204;
        }

        add_header Access-Control-Allow-Origin $firecalc_cors_origin always;
        add_header Access-Control-Expose-Headers "X-RateLimit-Limit, X-RateLimit-Remaining, X-RateLimit-Reset, Retry-After" always;
        add_header Vary "Origin" always;

        proxy_pass http://calc_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "public, max-age=3600" always;
    }

    # Payment redirect pages (HTML — need inline styles/scripts)
    location = /v1/payment_complete {
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "no-referrer-when-downgrade" always;
        add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; frame-ancestors 'none'" always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        proxy_pass http://api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /v1/payment_cancelled {
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "no-referrer-when-downgrade" always;
        add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; frame-ancestors 'none'" always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        proxy_pass http://api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Favicon — prevent browser auto-fetch from hitting backend/CSP
    location = /favicon.ico {
        return 204;
    }

    # Proxy to backend
    location / {
        proxy_pass http://api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;

        # Don't cache API responses
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }
}

# =============================================================================
# HTTP to HTTPS Redirects
# =============================================================================
upstream api_upstream_http {
    server backend:8181;
}

upstream calc_upstream_http {
    server calc-backend:9000;
}

server {
    listen 80 default_server;
    server_name ${UI_DOMAIN} ${API_DOMAIN};

    # Let's Encrypt challenge location (HTTP)
    location /.well-known/acme-challenge {
        default_type "text/plain";
        root /var/www/certbot;
        try_files $uri =404;
    }

    # Payments backend healthcheck — proxied to backend, bypasses HTTPS redirect
    location = /healthcheck {
        proxy_pass http://api_upstream_http/v1/healthcheck;
        proxy_http_version 1.1;
    }

    # Calculation backend healthcheck — proxied to calc-backend, bypasses HTTPS redirect
    location = /calc-healthcheck {
        proxy_pass http://calc_upstream_http/health;
        proxy_http_version 1.1;
    }

    # Redirect everything else to HTTPS
    location / {
        return 301 https://$server_name$request_uri;
    }
}
