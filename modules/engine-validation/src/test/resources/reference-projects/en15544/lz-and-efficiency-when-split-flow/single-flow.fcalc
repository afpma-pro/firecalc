version: 7
engine_state: 
  version: 7
  locale: "fr"
  display_units: "SI"
  standard_or_computation_method: "EN 15544:2023"
  project_description: 
    reference: "single flow regression"
    date: ""
    country: "France"
  local_conditions: 
    altitude: 
      value: "100"
      unit: "meter"
    coastal_region: false
    chimney_termination: 
      chimney_location_on_roof: 
        chimney_height_above_ridgeline: "MoreThan40cm"
        horizontal_distance_between_chimney_and_ridgeline: !!null
        slope: !!null
        outside_air_intake_and_chimney_locations: !!null
        horizontal_distance_between_chimney_and_ridgeline_bis: !!null
      adjacent_buildings: 
        horizontal_distance_between_chimney_and_adjacent_buildings: "MoreThan15m"
        horizontal_angle_between_chimney_and_adjacent_buildings: !!null
        vertical_angle_between_chimney_and_adjacent_buildings: !!null
  stove_params: 
    sizing_method: "MaxLoad"
    maximum_load: 
      value: "14"
      unit: "kilogram"
    nominal_heat_output: !!null
    heating_cycle: 
      value: "8"
      unit: "hour"
    min_efficiency: 
      value: "78"
      unit: "percent"
    facing_type: "WithoutAirGap"
    inner_construction_material: "WithinSpecs"
  air_intake_pipes: 
    initialDir: 
      azimuth: "Right"
      inclination: "Horizontal"
    position: 
      FinalAuto: true
    descr: 
      - 
        SetMaterial: 
          material: 
            WeldedSteel: 
              roughness: 
                value: "0.001"
                unit: "meter"
      - 
        SetInnerShape: 
          shape: 
            Circle: 
              diameter: 
                value: "0.18"
                unit: "meter"
      - 
        AddSectionSlopped: 
          name: "élément droit"
          length: 
            value: "1"
            unit: "meter"
  firebox: 
    AFPMA_PRSE: 
      heat_output_reduced: !!null
      outside_air_location_in_heater: "FromBottom"
      outside_air_conduit_shape: 
        Circle: 
          diameter: 
            value: "0.1527"
            unit: "meter"
      firebox_depth: 
        value: "0.443"
        unit: "meter"
      firebox_width: 
        value: "0.332"
        unit: "meter"
      firebox_height: 
        value: "0.6"
        unit: "meter"
      height_of_first_row_of_air_injectors: 
        value: "0.09"
        unit: "meter"
      glass_width: 
        value: "0.27"
        unit: "meter"
      glass_height: 
        value: "0.33"
        unit: "meter"
      ash_pit_height: 
        value: "0.09"
        unit: "meter"
      floor_thickness: 
        value: "0.06"
        unit: "meter"
      combustion_air_manifold_height: 
        value: "0.12"
        unit: "meter"
      outside_air_inlet_lip: 
        value: "0.04"
        unit: "meter"
      height_of_air_feed_to_columns: 
        value: "0.09"
        unit: "meter"
      number_of_air_columns_feeding_firebox: 11
      number_of_air_columns_feeding_door: 3
  post_firebox_pipes: 
    initialDirection: 
      azimuth: "Rear"
      inclination: "Horizontal"
    initialPosition: 
      Auto: true
    slots: 
      - 
        FlueSlot: 
          - 
            SetRoughness: 
              roughness: 
                value: "0.003"
                unit: "meter"
          - 
            SetInnerShape: 
              shape: 
                Rectangle: 
                  a: 
                    value: "0.44"
                    unit: "meter"
                  b: 
                    value: "0.18"
                    unit: "meter"
          - 
            AddSectionSlopped: 
              name: "sortie de foyer"
              length: 
                value: "0.192"
                unit: "meter"
          - 
            AddSharpeAngle_0_to_180: 
              name: "Angle vif de 0 à 180° ↱"
              angle: 
                value: "90"
                unit: "degree"
              absDir: 
                azimuth: "Left"
                inclination: "Horizontal"
          - 
            AddSectionSlopped: 
              name: "séparation"
              length: 
                value: "0.12300000000000001"
                unit: "meter"
          - 
            AddSharpeAngle_0_to_180: 
              name: "vers section horizontale"
              angle: 
                value: "90"
                unit: "degree"
              absDir: 
                azimuth: !!null
                inclination: "Down"
          - 
            SetInnerShape: 
              shape: 
                Rectangle: 
                  a: 
                    value: "0.12"
                    unit: "meter"
                  b: 
                    value: "0.19"
                    unit: "meter"
          - 
            AddSectionSlopped: 
              name: "descente"
              length: 
                value: "0.66"
                unit: "meter"
          - 
            AddSharpeAngle_0_to_180: 
              name: "vers remontée"
              angle: 
                value: "90"
                unit: "degree"
              absDir: 
                azimuth: "Rear"
                inclination: "Horizontal"
          - 
            SetInnerShape: 
              shape: 
                Rectangle: 
                  a: 
                    value: "0.19"
                    unit: "meter"
                  b: 
                    value: "0.12"
                    unit: "meter"
          - 
            AddSectionSlopped: 
              name: "horizontal"
              length: 
                value: "0.18"
                unit: "meter"
          - 
            AddSharpeAngle_0_to_180: 
              name: "Angle vif de 0 à 180° ↱"
              angle: 
                value: "90"
                unit: "degree"
              absDir: 
                azimuth: !!null
                inclination: "Up"
          - 
            SetInnerShape: 
              shape: 
                Rectangle: 
                  a: 
                    value: "0.12"
                    unit: "meter"
                  b: 
                    value: "0.19"
                    unit: "meter"
          - 
            AddSectionSlopped: 
              name: "élément droit"
              length: 
                value: "0.92"
                unit: "meter"
          - 
            AddSharpeAngle_0_to_180: 
              name: "Angle vif de 0 à 180° ↱"
              angle: 
                value: "90"
                unit: "degree"
              absDir: 
                azimuth: "Front"
                inclination: "Horizontal"
          - 
            SetInnerShape: 
              shape: 
                Rectangle: 
                  a: 
                    value: "0.19"
                    unit: "meter"
                  b: 
                    value: "0.12"
                    unit: "meter"
          - 
            AddSectionSlopped: 
              name: "élément droit"
              length: 
                value: "0.76"
                unit: "meter"
          - 
            AddSharpeAngle_0_to_180: 
              name: "Angle vif de 0 à 180° ↱"
              angle: 
                value: "90"
                unit: "degree"
              absDir: 
                azimuth: "Right"
                inclination: "Horizontal"
          - 
            AddSectionSlopped: 
              name: "élément droit"
              length: 
                value: "0.12300000000000001"
                unit: "meter"
          - 
            AddSharpeAngle_0_to_180: 
              name: "Angle vif de 0 à 180° ↱"
              angle: 
                value: "90"
                unit: "degree"
              absDir: 
                azimuth: !!null
                inclination: "Up"
          - 
            AddSectionSlopped: 
              name: "élément droit"
              length: 
                value: "0.08199999999999999"
                unit: "meter"
          - 
            SetRoughness: 
              roughness: 
                value: "0.001"
                unit: "meter"
          - 
            SetInnerShape: 
              shape: 
                Circle: 
                  diameter: 
                    value: "0.15"
                    unit: "meter"
          - 
            AddSectionSlopped: 
              name: "connecteur"
              length: 
                value: "0.06"
                unit: "meter"
      - 
        ConnectorSlot: 
          - 
            SetRoughness: 
              roughness: 
                value: "0.001"
                unit: "meter"
          - 
            SetInnerShape: 
              shape: 
                Circle: 
                  diameter: 
                    value: "0.2"
                    unit: "meter"
          - 
            SetLayers: 
              layers: 
                - 
                  FromThermalResistanceUsingThickness: 
                    thickness: 
                      value: "0.001"
                      unit: "meter"
                    thermal_resistance: 
                      value: "0.44"
                      unit: "(meter^2 Kelvin)/watt"
          - 
            SetPipeLocation: 
              pipe_location: "HeatedArea"
          - 
            AddSectionVertical: 
              name: "connecteur"
              elevation_gain: 
                value: "0.05"
                unit: "meter"
      - 
        ChimneySlot: 
          - 
            SetRoughness: 
              roughness: 
                value: "0.001"
                unit: "meter"
          - 
            SetInnerShape: 
              shape: 
                Circle: 
                  diameter: 
                    value: "0.15"
                    unit: "meter"
          - 
            SetLayers: 
              layers: 
                - 
                  FromThermalResistanceUsingThickness: 
                    thickness: 
                      value: "0.026000000000000002"
                      unit: "meter"
                    thermal_resistance: 
                      value: "0.44"
                      unit: "(meter^2 Kelvin)/watt"
          - 
            SetPipeLocation: 
              pipe_location: "HeatedArea"
          - 
            AddSectionVertical: 
              name: "conduit double peau isolé."
              elevation_gain: 
                value: "6"
                unit: "meter"
