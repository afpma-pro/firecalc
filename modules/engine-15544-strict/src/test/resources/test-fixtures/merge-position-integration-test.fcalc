version: 7
engine_state: 
  version: 7
  locale: "fr"
  display_units: "SI"
  standard_or_computation_method: "EN 15544:2023"
  project_description: 
    reference: ""
    date: ""
    country: "France"
  local_conditions: 
    altitude: 
      value: "100"
      unit: "meter"
    coastal_region: false
    chimney_termination: 
      chimney_location_on_roof: 
        chimney_height_above_ridgeline: "MoreThan40cm"
        horizontal_distance_between_chimney_and_ridgeline: !!null
        slope: !!null
        outside_air_intake_and_chimney_locations: !!null
        horizontal_distance_between_chimney_and_ridgeline_bis: !!null
      adjacent_buildings: 
        horizontal_distance_between_chimney_and_adjacent_buildings: "MoreThan15m"
        horizontal_angle_between_chimney_and_adjacent_buildings: !!null
        vertical_angle_between_chimney_and_adjacent_buildings: !!null
  stove_params: 
    sizing_method: "MaxLoad"
    maximum_load: 
      value: "15"
      unit: "kilogram"
    nominal_heat_output: !!null
    heating_cycle: 
      value: "8"
      unit: "hour"
    min_efficiency: 
      value: "78"
      unit: "percent"
    facing_type: "WithoutAirGap"
    inner_construction_material: "WithinSpecs"
  air_intake_pipes: 
    initialDir: 
      azimuth: "Right"
      inclination: "Horizontal"
    position: 
      FinalAuto: true
    descr: 
  firebox: 
    Traditional: 
      heat_output_reduced: !!null
      firebox_depth: 
        value: "0.4"
        unit: "meter"
      firebox_width: 
        value: "0.4"
        unit: "meter"
      firebox_height: 
        value: "0.62"
        unit: "meter"
      height_of_lowest_opening: 
        value: "0.05"
        unit: "meter"
      pressure_loss_coefficient_from_door: 
        value: "0.3"
        unit: "1"
      total_air_intake_surface_area_on_door: 
        value: "0.01"
        unit: "meter^2"
      glass_width: 
        value: "0.3"
        unit: "meter"
      glass_height: 
        value: "0.3"
        unit: "meter"
  post_firebox_pipes: 
    initialDirection: 
      azimuth: "Right"
      inclination: "Horizontal"
    initialPosition: 
      Auto: true
    slots: 
      - 
        FlueSlot: 
          - 
            SplitSingleFlowIntoTwoFlowsWith90DegTurn: 
              name: "Diviser en 2 flux avec virage à 90°"
              absDir: 
                azimuth: "Rear"
                inclination: "Horizontal"
              newInnerShape: 
                Circle: 
                  diameter: 
                    value: "0.18"
                    unit: "meter"
              symmetryPlaneAbsDir: !!null
          - 
            SetRoughness: 
              roughness: 
                value: "0.003"
                unit: "meter"
          - 
            AddSectionSlopped: 
              name: "sortie de foyer"
              length: 
                value: "0.3"
                unit: "meter"
          - 
            AddSharpeAngle_0_to_180: 
              name: "vers descente"
              angle: 
                value: "90"
                unit: "degree"
              absDir: 
                azimuth: !!null
                inclination: "Down"
          - 
            AddSectionSlopped: 
              name: "descente"
              length: 
                value: "1"
                unit: "meter"
          - 
            AddSharpeAngle_0_to_180: 
              name: "vers section horizontale"
              angle: 
                value: "90"
                unit: "degree"
              absDir: 
                azimuth: "Front"
                inclination: "Horizontal"
          - 
            AddSectionSlopped: 
              name: "section horizontale"
              length: 
                value: "0.2"
                unit: "meter"
          - 
            MergeTwoFlowsIntoSingleWith90DegTurn: 
              name: "Fusionner en 1 flux après virage à 90°"
              absDir: 
                azimuth: "Left"
                inclination: "Horizontal"
              newInnerShape: 
                Circle: 
                  diameter: 
                    value: "0.18"
                    unit: "meter"
              symmetryPlaneAbsDir: !!null
          - 
            AddSectionSlopped: 
              name: "section horizontale"
              length: 
                value: "0.5"
                unit: "meter"
          - 
            AddSharpeAngle_0_to_180: 
              name: "vers remontée"
              angle: 
                value: "90"
                unit: "degree"
              absDir: 
                azimuth: !!null
                inclination: "Up"
          - 
            AddSectionSlopped: 
              name: "remontée"
              length: 
                value: "0.5"
                unit: "meter"
      - 
        ConnectorSlot: 
          - 
            SetRoughness: 
              roughness: 
                value: "0.001"
                unit: "meter"
          - 
            SetInnerShape: 
              shape: 
                Circle: 
                  diameter: 
                    value: "0.2"
                    unit: "meter"
          - 
            SetLayers: 
              layers: 
                - 
                  FromThermalResistanceUsingThickness: 
                    thickness: 
                      value: "0.001"
                      unit: "meter"
                    thermal_resistance: 
                      value: "0.44"
                      unit: "(meter^2 Kelvin)/watt"
          - 
            SetPipeLocation: 
              pipe_location: "HeatedArea"
          - 
            AddSectionVertical: 
              name: "connecteur"
              elevation_gain: 
                value: "0.05"
                unit: "meter"
      - 
        ChimneySlot: 
          - 
            SetRoughness: 
              roughness: 
                value: "0.001"
                unit: "meter"
          - 
            SetInnerShape: 
              shape: 
                Circle: 
                  diameter: 
                    value: "0.2"
                    unit: "meter"
          - 
            SetLayers: 
              layers: 
                - 
                  FromThermalResistanceUsingThickness: 
                    thickness: 
                      value: "0.026000000000000002"
                      unit: "meter"
                    thermal_resistance: 
                      value: "0.44"
                      unit: "(meter^2 Kelvin)/watt"
          - 
            SetPipeLocation: 
              pipe_location: "HeatedArea"
          - 
            AddSectionVertical: 
              name: "conduit double peau isolé."
              elevation_gain: 
                value: "1"
                unit: "meter"
