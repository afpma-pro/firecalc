# Production environment configuration for FireCalc UI
# This file is loaded automatically by Vite when running in production mode
# These are placeholder (example.com) values; real hosts live in the gitignored .env.production.local override.

# Backend API Configuration
VITE_BACKEND_PROTOCOL=https
VITE_BACKEND_HOST=api.firecalc.example.com
VITE_BACKEND_PORT=443
VITE_BACKEND_BASE_PATH=/v1

# URL to Conditions Generales de Vente (CGUV / Terms and Conditions of Sale)
VITE_CGUV_URL=https://firecalc.example.com/conditions-generales-de-vente

# Firebox availability flags — UI-facing (which types the UI should show/allow)
VITE_FIREBOX_AVAIL_TRADITIONAL=true
VITE_FIREBOX_AVAIL_ECOLABELED=true
VITE_FIREBOX_AVAIL_AFPMA_PRSE=true
VITE_FIREBOX_AVAIL_SINGLE_TESTED=true
VITE_FIREBOX_AVAIL_DOOR15A_CATALOG=true

# Firebox availability flags — backend mirror (build-time snapshot of what the backend accepts)
VITE_FIREBOX_AVAIL_TRADITIONAL_BACKEND=true
VITE_FIREBOX_AVAIL_ECOLABELED_BACKEND=true
VITE_FIREBOX_AVAIL_AFPMA_PRSE_BACKEND=true
VITE_FIREBOX_AVAIL_SINGLE_TESTED_BACKEND=true
VITE_FIREBOX_AVAIL_DOOR15A_CATALOG_BACKEND=true

# Remote firebox calculation (tickets 09, 10, 21): Ecolabeled and Door15aCatalog
# compute exclusively on the standalone firebox-calc backend — the browser never
# runs the Austrian engine. Nginx routes exactly GET /v1/kinds and
# POST /v1/calculate on the API domain to the calc backend (ticket 05/21
# routing); the base URL is the API domain's /v1 prefix and the client appends
# /calculate and /kinds. Do not leave the base URL empty in deployed builds:
# Austrian kinds have no browser-side calculation source.
VITE_FIREBOX_REMOTE_KINDS=ecolabeled,door15a-catalog
VITE_FIREBOX_CALC_BASE_URL=https://api.firecalc.example.com/v1
# Prefetch retry defaults (matching UIConfig.scala fallbacks)
VITE_FIREBOX_PREFETCH_MAX_RETRIES=5
VITE_FIREBOX_PREFETCH_BASE_DELAY_MS=1000
VITE_FIREBOX_PREFETCH_MAX_DELAY_MS=30000

# Optional: Add production-specific feature flags or settings here
# VITE_ANALYTICS_ENABLED=true
# VITE_SENTRY_DSN=your-sentry-dsn-here
