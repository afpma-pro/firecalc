# Production environment configuration for FireCalc UI
# This file is loaded automatically by Vite when running in production mode

# Backend API Configuration
VITE_BACKEND_PROTOCOL=https
VITE_BACKEND_HOST=api.firecalc.example.com
VITE_BACKEND_PORT=443
VITE_BACKEND_BASE_PATH=/v1

# URL to Conditions Generales de Vente (CGUV / Terms and Conditions of Sale)
VITE_CGUV_URL=https://firecalc.example.com/conditions-generales-de-vente

# Firebox availability flags — UI-facing (which types the UI should show/allow)
VITE_FIREBOX_AVAIL_TRADITIONAL=true
VITE_FIREBOX_AVAIL_ECOLABELED=true
VITE_FIREBOX_AVAIL_AFPMA_PRSE=true
VITE_FIREBOX_AVAIL_SINGLE_TESTED=true
VITE_FIREBOX_AVAIL_DOOR15A_CATALOG=true

# Firebox availability flags — backend mirror (build-time snapshot of what the backend accepts)
VITE_FIREBOX_AVAIL_TRADITIONAL_BACKEND=true
VITE_FIREBOX_AVAIL_ECOLABELED_BACKEND=false
VITE_FIREBOX_AVAIL_AFPMA_PRSE_BACKEND=true
VITE_FIREBOX_AVAIL_SINGLE_TESTED_BACKEND=true
VITE_FIREBOX_AVAIL_DOOR15A_CATALOG_BACKEND=false

# Optional: Add production-specific feature flags or settings here
# VITE_ANALYTICS_ENABLED=true
# VITE_SENTRY_DSN=your-sentry-dsn-here
