# Development environment configuration for FireCalc UI
# This file is loaded automatically by Vite when running in development mode

# Backend API Configuration
VITE_BACKEND_PROTOCOL=http
VITE_BACKEND_HOST=localhost
VITE_BACKEND_PORT=8181
VITE_BACKEND_BASE_PATH=/v1

# URL to Conditions Generales de Vente (CGUV / Terms and Conditions of Sale)
VITE_CGUV_URL=https://localhost:5173/conditions-generales-de-vente

# Firebox availability flags — UI-facing (which types the UI should show/allow)
VITE_FIREBOX_AVAIL_TRADITIONAL=true
VITE_FIREBOX_AVAIL_ECOLABELED=true
VITE_FIREBOX_AVAIL_AFPMA_PRSE=true
VITE_FIREBOX_AVAIL_SINGLE_TESTED=true
VITE_FIREBOX_AVAIL_DOOR15A_CATALOG=true

# Firebox availability flags — backend mirror (build-time snapshot of what the backend accepts)
VITE_FIREBOX_AVAIL_TRADITIONAL_BACKEND=true
VITE_FIREBOX_AVAIL_ECOLABELED_BACKEND=true
VITE_FIREBOX_AVAIL_AFPMA_PRSE_BACKEND=true
VITE_FIREBOX_AVAIL_SINGLE_TESTED_BACKEND=true
VITE_FIREBOX_AVAIL_DOOR15A_CATALOG_BACKEND=true

# Remote firebox calculation (tickets 09 + 10): Ecolabeled and Door15aCatalog
# compute exclusively on the standalone firebox-calc server (default port 9000)
# — the browser never runs the Austrian engine. The base URL carries the /v1
# route prefix; the client appends /calculate and /kinds.
VITE_FIREBOX_REMOTE_KINDS=ecolabeled,door15a-catalog
VITE_FIREBOX_CALC_BASE_URL=http://localhost:9000/v1
# Prefetch retry defaults (matching UIConfig.scala fallbacks)
VITE_FIREBOX_PREFETCH_MAX_RETRIES=5
VITE_FIREBOX_PREFETCH_BASE_DELAY_MS=1000
VITE_FIREBOX_PREFETCH_MAX_DELAY_MS=30000
