{
    "name": "firecalc-ui",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "license": "AGPL-3.0-or-later",
    "devDependencies": {
        "@scala-js/vite-plugin-scalajs": "^1.1.0",
        "@tailwindcss/typography": "^0.5.19",
        "@vitejs/plugin-basic-ssl": "^2.1.4",
        "cross-env": "^7.0.3",
        "esbuild": "^0.25.0",
        "tailwindcss": "^4.1.18",
        "typescript": "^5.9.2",
        "vite": "^7.3.1",
        "vite-plugin-singlefile": "^2.3.0"
    },
    "browserslist": [
        "defaults"
    ],
    "scripts": {
        "dev": "vite --mode development",
        "dev:staging": "vite --mode staging",
        "dev:production": "vite --mode production",
        "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build --mode development --emptyOutDir",
        "build:staging": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build --mode staging --emptyOutDir",
        "build:production": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build --mode production --emptyOutDir",
        "serve": "vite preview",
        "build:viz": "esbuild ../viz/src/ts/filaire-viz.ts --bundle --format=esm --external:three --banner:js='/* SPDX-License-Identifier: AGPL-3.0-or-later | Copyright (C) 2026 Association Française du Poêle Maçonné Artisanal */' --outfile=../viz/src/main/resources/afpma/firecalc/filaire/filaire-viz.js",
        "clean": "rm -rf node_modules"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.1.18",
        "daisyui": "^5.5.18",
        "three": "^0.182.0"
    }
}
