    value: "4.056"
    unit: "kilo watt"
  heating_cycle: 
    value: "12"
    unit: "hour"
  min_efficiency: 
    value: "78"
    unit: "percent"
  facing_type: "WithoutAirGap"
  inner_construction_material: "WithinSpecs"
