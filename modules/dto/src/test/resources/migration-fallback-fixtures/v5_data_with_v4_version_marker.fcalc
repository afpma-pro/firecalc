version: 4
locale: "fr"
display_units: "SI"
standard_or_computation_method: "EN 15544:2023"
project_description: 
  reference: "06 PDM foyer éco-labellisé KOV"
  date: "26 mars 2026"
  country: "France"
local_conditions: 
  altitude: 
    value: "128"
    unit: "meter"
  coastal_region: false
  chimney_termination: 
