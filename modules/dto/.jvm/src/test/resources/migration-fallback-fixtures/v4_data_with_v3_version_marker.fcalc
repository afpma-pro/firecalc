  nominal_heat_output: !!null
  heating_cycle: 
    value: "8"
    unit: "hour"
  min_efficiency: 
    value: "70"
    unit: "percent"
  facing_type: "WithoutAirGap"
  inner_construction_material: "WithinSpecs"
air_intake_descr: 
