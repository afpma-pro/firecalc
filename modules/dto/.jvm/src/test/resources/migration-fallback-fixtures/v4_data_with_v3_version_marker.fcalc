        inclination: "Up"
  - 
    SetInnerShape: 
      shape: 
        Rectangle: 
          a: 
            value: "0.141"
            unit: "meter"
          b: 
            value: "0.141"
            unit: "meter"
  - 
    AddSectionSlopped: 
      name: "élément droit"
      length: 
        value: "2.9530000000000003"
        unit: "meter"
  - 
    SetInnerShape: 
      shape: 
