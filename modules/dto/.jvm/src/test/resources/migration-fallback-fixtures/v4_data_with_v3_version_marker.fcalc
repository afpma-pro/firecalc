    SetRoughness: 
      roughness: 
        value: "0.001"
        unit: "meter"
  - 
    SetInnerShape: 
      shape: 
        Circle: 
          diameter: 
            value: "0.15"
            unit: "meter"
  - 
    SetLayers: 
      layers: 
        - 
          FromThermalResistanceUsingThickness: 
            thickness: 
              value: "0.025"
              unit: "meter"
            thermal_resistance: 
              value: "0.26"
              unit: "(meter^2 Kelvin)/watt"
