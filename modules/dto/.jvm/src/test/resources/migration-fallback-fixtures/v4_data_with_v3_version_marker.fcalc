version: 3
locale: "fr"
display_units: "SI"
standard_or_computation_method: "EN 15544:2023"
project_description: 
  reference: "01-Colonne ascendante"
  date: ""
  country: "France"
local_conditions: 
  altitude: 
    value: "200"
    unit: "meter"
  coastal_region: false
  chimney_termination: 
    chimney_location_on_roof: 
      chimney_height_above_ridgeline: "MoreThan40cm"
